{
  "name": "QR Studio",
  "short_name": "QR Studio",
  "description": "Make styled QR codes and scan them, even offline. Arabic and English. إنشاء رموز QR وقراءتها.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f7f6",
  "theme_color": "#0f766e",
